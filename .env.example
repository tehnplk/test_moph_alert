# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# https://moph-alert.moph.go.th

CLIENT_KEY=your_client_key_here
SECRET_KEY=your_secret_key_here

# ผู้รับ — เพิ่มได้เรื่อย ๆ เป็น CID_1, CID_2, CID_3, ...
CID_1=1234567890123
CID_2=

# URL รูปสำหรับส่ง image message (สร้างด้วย  python upload_image.py <ต้นฉบับ> <รูปย่อ>)
# LINE บังคับ HTTPS  ต้นฉบับไม่เกิน 10 MB  รูปย่อไม่เกิน 1 MB
IMG_URL=
IMG_PREVIEW_URL=
